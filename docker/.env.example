# How the app is reached.
#   Local:    http://localhost:8080
#   Internet: https://iss.example.com
ISS_VANGUARD_URL=http://localhost:8080

# Bare hostname for the Traefik routing rule (docker-compose.override.yml).
# Only needed when running behind a reverse proxy. Must match the host in
# ISS_VANGUARD_URL.
# ISS_VANGUARD_HOST=iss.example.com

# Secret key for signing session cookies.
# Generate a value with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED — the app will fail to start without this.
SESSION_SECRET=
